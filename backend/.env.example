# ============================================================
# NEXGENCLASS BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Server Port & Environment
PORT=3000
NODE_ENV=production

# MongoDB Database URI (MongoDB Atlas or Self-Hosted)
MONGO_URI=mongodb://localhost:27017/nexgenclass

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# CORS Allowed Origins (Comma-separated for multi-domain)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://nex-gen-class.vercel.app

# AI Copilot Provider (NVIDIA NIM, OpenAI, or Built-in Local Engine Fallback)
AI_API_KEY=your_nim_or_openai_api_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_NAME=meta/llama-3.1-70b-instruct
AI_MAX_CONTEXT_CHARS=30000

# File Storage Provider (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=50

# Email SMTP Notification Service (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@example.com
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM="NexGenClass <notifications@example.com>"
