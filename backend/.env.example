# ============================================================
# NEXGENCLASS BACKEND PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================

# Server Port & Environment
PORT=3000
NODE_ENV=production

# MongoDB Database URI (MongoDB Atlas or Self-Hosted)
MONGO_URI=mongodb://localhost:27017/manas-nexgen
# Database name used by the app (overrides any name in MONGO_URI)
MONGO_DB_NAME=manas-nexgen

# JWT Secret for Session Authentication & Token Signing
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# CORS Allowed Origins (Comma-separated for multi-domain)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://nex-gen-class.vercel.app

# AI Copilot Provider (NVIDIA NIM, OpenAI, or Built-in Local Engine Fallback)
AI_API_KEY=your_nim_or_openai_api_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_NAME=meta/llama-3.1-70b-instruct
AI_MAX_CONTEXT_CHARS=30000

# File Storage Provider (local or s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=50

# ---------- Email (Nodemailer via Brevo SMTP; any SMTP provider works) ----------
# Brevo: Dashboard -> SMTP & API -> SMTP tab. SMTP_USER is the "Login" shown there (looks like xxxx@smtp-brevo.com),
# SMTP_PASS is an SMTP key you generate there (NOT your Brevo account password).
# EMAIL_FROM must be a sender verified in Brevo (Senders, Domains & Dedicated IPs -> Senders).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
EMAIL_FROM="NexGenClass <your_verified_sender@example.com>"
# Hosts that block SMTP ports (Render free tier blocks 25/465/587): use Brevo's HTTPS API instead.
# Create an API key at Brevo -> SMTP & API -> API Keys (starts with xkeysib-; different from the SMTP key).
# When set, it is used instead of SMTP. Alternatively try SMTP_PORT=2525.
BREVO_API_KEY=

# ---------- SMS (optional; nothing is sent unless enabled) ----------
SMS_ENABLED=false
SMS_PROVIDER=none            # msg91 | fast2sms | none
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# ---------- Scheduling / delivery ----------
APP_TIMEZONE=Asia/Kolkata
REMINDER_CRON=*/10 * * * *
REMINDER_WINDOW_HOURS=24
CRON_SECRET=generate_a_long_random_string   # protects POST /api/notifications/internal/run-scheduled (serverless hosts)
