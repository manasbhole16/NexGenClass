# ============================================================
# NEXGENCLASS PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Connection
MONGO_URI=mongodb://localhost:27017/nexgenclass

# Authentication & Session Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
SESSION_SECRET=your_session_secret_key_here

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# AI Academic Copilot Configuration (Optional: Falls back to local engine if omitted)
AI_API_KEY=your_nim_or_openai_api_key_here
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL_NAME=meta/llama-3.1-70b-instruct
AI_MAX_CONTEXT_CHARS=30000

# File Storage Configuration (Local File System or S3 Compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_MAX_FILE_SIZE_MB=50

# Email Service Configuration (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@example.com
EMAIL_PASS=your_smtp_password_here
EMAIL_FROM="NexGenClass <notifications@example.com>"
