{
  "expo": {
    "name": "NexGenClass",
    "slug": "nexgenclass-mobile",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "nexgenclass",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121216"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexgenclass.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121216"
      },
      "package": "com.nexgenclass.mobile"
    }
  }
}
